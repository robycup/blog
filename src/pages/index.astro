---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="it">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container home-page">
			<section class="intro">
				<p class="eyebrow">Un blog personale su tecnologia</p>
				<h1>Capire a fondo.<br /><span>Costruire meglio.</span></h1>
				<p class="intro-copy">{SITE_DESCRIPTION}</p>
				<a class="button" href="/blog/">Esplora gli articoli <span aria-hidden="true">↗</span></a>
			</section>

			<section class="latest" aria-labelledby="latest-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Dal taccuino</p>
						<h2 id="latest-heading">Articoli recenti</h2>
					</div>
					<a class="all-link" href="/blog/">Tutti gli articoli <span aria-hidden="true">→</span></a>
				</div>

				{posts.length > 0 ? (
					<div class="post-list">
						{posts.map((post) => (
							<article class="post-card">
								<div class="post-meta">
									<span class="category">{post.data.category}</span>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
								<p>{post.data.description}</p>
							</article>
						))}
					</div>
				) : (
					<div class="empty-state">
						<h3>I primi articoli sono in arrivo.</h3>
						<p>Intanto, qui troverai appunti e guide su software, intelligenza artificiale e DevOps.</p>
					</div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-page {
		padding-top: clamp(4rem, 10vw, 8rem);
	}
	.intro {
		max-width: 780px;
		padding-bottom: clamp(4rem, 11vw, 8rem);
	}
	.intro h1 {
		margin: 0;
		font-size: clamp(3.2rem, 9vw, 6.6rem);
		letter-spacing: -0.065em;
		line-height: 0.98;
	}
	.intro h1 span {
		color: var(--accent);
	}
	.eyebrow {
		margin: 0 0 1rem;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.intro-copy {
		max-width: 600px;
		margin: 1.6rem 0 1.8rem;
		color: var(--muted);
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.7;
	}
	.button {
		display: inline-flex;
		align-items: center;
		gap: 1.25rem;
		padding: 0.85rem 1.15rem;
		border-radius: 999px;
		background: var(--ink);
		color: white;
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent);
		color: white;
	}
	.latest {
		padding-bottom: clamp(4rem, 8vw, 7rem);
	}
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.section-heading .eyebrow {
		margin-bottom: 0.35rem;
	}
	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.8rem, 4vw, 2.5rem);
		letter-spacing: -0.04em;
	}
	.all-link {
		color: var(--muted);
		font-size: 0.92rem;
		text-decoration: none;
		white-space: nowrap;
	}
	.all-link:hover {
		color: var(--accent);
	}
	.post-list {
		border-top: 1px solid var(--line);
	}
	.post-card {
		padding: 1.6rem 0;
		border-bottom: 1px solid var(--line);
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		color: var(--muted);
		font-size: 0.8rem;
	}
	.category {
		color: var(--accent);
		font-weight: 700;
	}
	.post-card h3 {
		margin: 0.55rem 0;
		font-size: clamp(1.3rem, 3vw, 1.8rem);
		letter-spacing: -0.03em;
	}
	.post-card h3 a {
		color: var(--ink);
		text-decoration: none;
	}
	.post-card h3 a:hover {
		color: var(--accent);
	}
	.post-card p {
		max-width: 700px;
		margin: 0;
		color: var(--muted);
		font-size: 0.98rem;
	}
	.empty-state {
		padding: 2rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.empty-state h3 {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
	}
	.empty-state p {
		margin: 0;
		color: var(--muted);
	}
	@media (max-width: 520px) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
