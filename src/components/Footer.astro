---
import { AUTHOR_NAME, SITE_TITLE } from '../consts';
---

<footer>
	<div class="container footer-inner">
		<p>© {new Date().getFullYear()} {AUTHOR_NAME} · {SITE_TITLE}</p>
		<a href="/rss.xml">Segui gli articoli via RSS</a>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.9rem;
	}
	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.5rem;
	}
	.footer-inner p {
		margin: 0;
	}
	.footer-inner a {
		color: var(--muted);
	}
	@media (max-width: 520px) {
		.footer-inner {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
