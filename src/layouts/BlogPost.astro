---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, category, heroImage } = Astro.props;
---

<!doctype html>
<html lang="it">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
	</head>

	<body>
		<Header />
		<main class="container article-page">
			<article class="prose">
				<a class="back-link" href="/blog/">← Tutti gli articoli</a>
				<p class="eyebrow">{category}</p>
				<h1>{title}</h1>
				<p class="article-description">{description}</p>
				<p class="article-date">
					Pubblicato il <FormattedDate date={pubDate} />
					{updatedDate && <> · aggiornato il <FormattedDate date={updatedDate} /></>}
				</p>
				{heroImage && (
					<Image
						class="hero-image"
						src={heroImage}
						alt=""
						widths={[720, 1020]}
						sizes="(max-width: 720px) 100vw, 720px"
					/>
				)}
				<hr />
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-page {
		padding-block: clamp(3rem, 8vw, 6rem);
	}
	.article-page article {
		max-width: 740px;
		margin-inline: auto;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 2.5rem;
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--accent);
	}
	.eyebrow {
		margin-bottom: 0.75rem;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin-bottom: 1rem;
		font-size: clamp(2.2rem, 6vw, 3.7rem);
		letter-spacing: -0.045em;
	}
	.article-description {
		color: var(--muted);
		font-size: 1.2rem;
		line-height: 1.6;
	}
	.article-date {
		color: var(--muted);
		font-size: 0.88rem;
	}
	.hero-image {
		width: 100%;
		height: auto;
		margin-block: 2rem;
		border-radius: var(--radius);
	}
	hr {
		margin-block: 2rem;
		border: 0;
		border-top: 1px solid var(--line);
	}
</style>
